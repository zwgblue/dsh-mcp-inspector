{
  "name": "dsh-mcp-inspector",
  "version": "1.0.0",
  "description": "Sidebar panel for the DeepSeek Harness Web UI: lists configured MCP servers with live status, expandable configuration and methods, and a per-server on/off switch.",
  "type": "module",
  "license": "MIT",
  "author": "zhouwenguo",
  "homepage": "https://github.com/YOUR-GITHUB-USERNAME/dsh-mcp-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-GITHUB-USERNAME/dsh-mcp-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR-GITHUB-USERNAME/dsh-mcp-inspector/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
